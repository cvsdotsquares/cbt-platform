# Copy to apps/api/.env (Prisma and NestJS read this file)
NODE_ENV=development
APP_URL=http://localhost:3002
API_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL — Docker: pnpm docker:up | Without Docker: install PostgreSQL locally (see README)
DATABASE_URL=postgresql://cbt_user:cbt_password@localhost:5432/cbt_platform?schema=public

# Redis optional in dev — leave empty if not installed
REDIS_URL=

JWT_ACCESS_SECRET=dev-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=3h
MFA_ISSUER=CBT Platform
TOTP_WINDOW=1

# AI / LLM (OpenAI — powers AI Studio question generation)
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Production security — false = invite-only student signup (see Students → Invite Student)
ALLOW_PUBLIC_REGISTRATION=false
# Optional when ALLOW_PUBLIC_REGISTRATION=true: comma-separated school email domains
# ALLOWED_REGISTRATION_EMAIL_DOMAINS=school.edu.in,students.school.edu.in
SEED_DEMO_USERS=false
UPLOAD_DIR=./uploads/materials

# S3 storage (recommended for production — leave empty to use local disk)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
