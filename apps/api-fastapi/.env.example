# CBT Platform FastAPI Backend Configuration
PROJECT_NAME="CBT Platform API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL with psycopg 3 driver)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/cbt_db"
ASYNC_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/cbt_db"

# Security (JWT secret for future auth phases)
JWT_SECRET="change-this-in-production-super-secret-key-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (JSON array string or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
