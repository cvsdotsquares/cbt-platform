{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/v1/[...path]",
      "regex": "^/api/v1/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/v1/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/exam/instructions/[examId]",
      "regex": "^/exam/instructions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPexamId": "nxtPexamId"
      },
      "namedRegex": "^/exam/instructions/(?<nxtPexamId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/exam/start/[examId]",
      "regex": "^/exam/start/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPexamId": "nxtPexamId"
      },
      "namedRegex": "^/exam/start/(?<nxtPexamId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/verify/certificate/[id]",
      "regex": "^/verify/certificate/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/verify/certificate/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
