# Copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=http://localhost:3002
NEXT_PUBLIC_TENANT_ID=default
API_PROXY_URL=http://localhost:3002

# Server-only — must match apps/api JWT_ACCESS_SECRET for cookie session verification
JWT_ACCESS_SECRET=dev-access-secret-min-32-characters-long

# Production security (must match API)
ALLOW_PUBLIC_REGISTRATION=false
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false
