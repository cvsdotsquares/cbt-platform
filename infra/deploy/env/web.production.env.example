# Placeholder — copy to apps/web/.env.production on the PRODUCTION checkout.
# NEXT_PUBLIC_* are baked in at `next build` time.

NEXT_PUBLIC_API_URL=https://PROD_API_HOST/api/v1
NEXT_PUBLIC_WS_URL=wss://PROD_API_HOST
# Match API ALLOW_PUBLIC_REGISTRATION=false for invite-only student signup UI
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false
API_PROXY_URL=http://127.0.0.1:4030

# Must match apps/api/.env JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=CHANGE_ME_same_as_api_jwt_access_secret
