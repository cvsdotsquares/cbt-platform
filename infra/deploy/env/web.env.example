# Placeholder — copy to apps/web/.env.production on the server checkout.
# NEXT_PUBLIC_* are baked in at `next build` time.

NEXT_PUBLIC_API_URL=https://API_HOST/api/v1
NEXT_PUBLIC_WS_URL=wss://API_HOST
# Match API ALLOW_PUBLIC_REGISTRATION=false for invite-only student signup UI
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false
API_PROXY_URL=http://127.0.0.1:4010

# Used by Next.js auth proxy (keep in sync with your auth setup)
JWT_ACCESS_SECRET=CHANGE_ME_same_as_api_jwt_secret_or_web_auth_secret
