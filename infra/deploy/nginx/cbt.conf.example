# Nginx reverse proxy example — company server (no Docker).
# Copy to /etc/nginx/sites-available/cbt.conf, adjust domains/ports, enable & reload.
#
# Placeholders: WEB_HOST, API_HOST
# Upstream ports must match infra/deploy/pm2/ecosystem.cjs (default 3010 / 4010)

upstream cbt_web { server 127.0.0.1:3010; }
upstream cbt_api { server 127.0.0.1:4010; }

server {
  listen 80;
  server_name WEB_HOST;  # e.g. cbt.yourcompany.com

  location / {
    proxy_pass http://cbt_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name API_HOST;  # e.g. cbt-api.yourcompany.com

  location / {
    proxy_pass http://cbt_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}

# After DNS + certbot:
#   sudo certbot --nginx -d WEB_HOST -d API_HOST
